
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  background: #ffffff;
  color: #222222;
  font-family: Arial, sans-serif;
}

h1, h2, h3 {
  color: #111111;
}

input, select, textarea {
  width: 100%;
  padding: 12px;
  margin: 8px 0;
  border: 1px solid #cccccc;
  border-radius: 8px;
  background: #ffffff;
  color: #222222;
  font-size: 16px;
}

button {
  padding: 12px 18px;
  margin: 6px 0;
  border: none;
  border-radius: 8px;
  background: #16a34a;
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #15803d;
}

button:disabled {
  opacity: 0.6;
}

section, .card, .box {
  margin: 14px 0;
  padding: 16px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

a {
  color: #15803d;
}

li {
  margin: 8px 0;
}
